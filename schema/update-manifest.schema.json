{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gaio-x/xwork/main/schema/update-manifest.schema.json",
  "title": "Xwork 更新清单",
  "description": "update/stable.json 与 update/beta.json 的字段定义。不兼容变更须递增 schema 号。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "app", "published_at", "latest"],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1,
      "description": "清单格式版本。客户端只认已实现的版本，未知值一律拒绝更新。"
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta"],
      "description": "渠道，必须与所在文件一致（stable.json → stable）。"
    },
    "app": {
      "type": "string",
      "const": "xwork",
      "description": "应用标识，防止清单被串用。"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "清单发布时间（ISO 8601，带时区）。"
    },
    "latest": { "$ref": "#/$defs/release" },
    "history": {
      "type": "array",
      "description": "最近若干历史版本，供客户端列\"回滚到旧版\"候选。新的在前。",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "released_at", "tag"],
        "properties": {
          "version": { "$ref": "#/$defs/version" },
          "released_at": { "$ref": "#/$defs/date" },
          "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([-.][0-9A-Za-z.]+)?$" }
        }
      }
    },
    "signature": {
      "type": "object",
      "description": "对清单正文（去掉 signature 后按 key 排序的紧凑 JSON）的签名。默认关闭。",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": { "type": "string", "const": "ed25519" },
        "key_id": { "type": "string", "description": "用于标识/轮换公钥，客户端首次成功校验后记住该 id 的指纹。" },
        "value": { "type": "string", "description": "Base64 编码的 Ed25519 签名。" }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.][0-9A-Za-z.]+)?$",
      "description": "语义化版本，不带 v 前缀。必须与 core/version.py 的 VERSION 完全一致。"
    },
    "date": { "type": "string", "format": "date" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "released_at", "min_version", "mandatory", "notes", "platforms"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "released_at": { "$ref": "#/$defs/date" },
        "min_version": {
          "$ref": "#/$defs/version",
          "description": "低于此版本不保证平滑升级：客户端改走整包覆盖并提示先备份。"
        },
        "mandatory": {
          "type": "boolean",
          "description": "true = 强制更新（仅安全修复），UI 不可跳过。"
        },
        "notes_url": {
          "type": "string",
          "format": "uri",
          "description": "更新说明 Markdown 地址，可省略（省略时客户端只显示 notes）。"
        },
        "notes": {
          "type": "string",
          "maxLength": 200,
          "description": "一句话摘要，必须离线可读，不依赖 notes_url。"
        },
        "platforms": {
          "type": "object",
          "minProperties": 1,
          "description": "按平台/架构分组。当前只需 win-x64。",
          "propertyNames": { "pattern": "^(win|linux|mac)-(x64|arm64)$|^(portable|source)$" },
          "additionalProperties": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "size", "sha256", "url"],
      "properties": {
        "kind": { "type": "string", "enum": ["zip-onedir"] },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.zip$",
          "description": "附件文件名，必须与 Release 附件完全一致（ASCII）。"
        },
        "size": { "type": "integer", "minimum": 1, "description": "精确字节数，用于进度与续传校验。" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "url": { "type": "string", "format": "uri", "description": "GitHub Release 原始地址。" },
        "mirrors": {
          "type": "array",
          "description": "有序兜底镜像。客户端按顺序试；每项都是把 url 套上前缀得到。",
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
